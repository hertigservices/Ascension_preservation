/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self'; worker-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://hertigservices.github.io; img-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'
/manifest.json
  Cache-Control: no-cache
/config.json
  Cache-Control: no-cache
/records/*
  Cache-Control: public, max-age=31536000, immutable
/search/*
  Cache-Control: public, max-age=31536000, immutable
